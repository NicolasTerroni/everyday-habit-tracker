# Neon (Free plan, no payment method)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Direct connection used by Drizzle migrations; Vercel's Neon integration supplies it.
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional, comma-separated. Useful for testing from a phone on your LAN.
BETTER_AUTH_TRUSTED_ORIGINS=
# Hostnames only, comma-separated. Example: 192.168.1.39
ALLOWED_DEV_ORIGINS=

# Generate with: npm run vapid:generate
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: password reset emails through Resend Free (no payment method).
# Without RESEND_API_KEY the reset link is written to the server log instead (Vercel: Logs).
# Without a verified domain, Resend's test sender only delivers to your own Resend account email.
RESEND_API_KEY=
EMAIL_FROM=Everyday <onboarding@resend.dev>

# Optional: access for a personal integration or the focus-lock Shortcut (/api/integration/*).
# Store only the SHA-256 (hex) of a random token here; the integration sends the token itself.
INTEGRATION_TOKEN_SHA256=
INTEGRATION_USER_EMAIL=

# Upstash QStash Free (no payment method)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
